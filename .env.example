# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------

# Generate locally with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-generated-secret-key

# Required deployment mode: commerce or research.
# Research deployments must omit every STRIPE_* variable below.
TREADJOY_MODE=commerce

# Required environment: local, ci, staging, or production.
# The checked-in example is intentionally a local-only profile.
TREADJOY_ENVIRONMENT=local
TREADJOY_INGRESS=direct
# Set true only on the owner-scoped staging research POC. It permits the
# temporary single-mailbox exception and draft policy placeholders; it is
# rejected for local, CI, and commerce configurations.
TREADJOY_PRIVATE_POC=false

# Use True only for local development.
DJANGO_DEBUG=True

# Comma-separated hostnames without http:// or https://
ALLOWED_HOSTS=localhost,127.0.0.1


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Commerce and research deployments must use separate databases.

DB_NAME=treadjoy
DB_USER=treadjoy_app
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Render Blueprints provide DATABASE_URL from the private Postgres connection
# string. When present, DB_NAME/USER/PASSWORD/HOST/PORT may be omitted and
# DB_SSLMODE defaults to require in public environments.
# DATABASE_URL=postgresql://user:password@host:5432/database


# -----------------------------------------------------------------------------
# Public-environment contract (staging and production only)
# -----------------------------------------------------------------------------

# Set every value in the deployment platform's secret/configuration store.
# These examples are placeholders, not active TreadJoy hostnames or services.
# TREADJOY_INGRESS=cloudflare-locked
# The Cloudflare Transform Rule overwrites X-TreadJoy-Origin with this value;
# use a generated secret in the public secret store, never in source control.
# TREADJOY_ORIGIN_SHARED_SECRET=replace-with-a-generated-origin-lock-secret
# DJANGO_DEBUG=false
# ALLOWED_HOSTS=research.example.com
# CSRF_TRUSTED_ORIGINS=https://research.example.com
# DB_SSLMODE=require
# STATIC_ROOT=/app/staticfiles
# R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# R2_BUCKET_NAME=replace-with-public-media-bucket
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# R2_MEDIA_CUSTOM_DOMAIN=media.example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-with-smtp-user
# EMAIL_HOST_PASSWORD=replace-with-smtp-password
# DEFAULT_FROM_EMAIL=noreply@example.com
# SERVER_EMAIL=errors@example.com
# Research-only public profile. Notice text/version/hash must match the approved
# A1.4 record; these placeholders are not legal approval or launchable copy.
# RESEARCH_PRIVACY_NOTICE_VERSION=replace-with-approved-version
# RESEARCH_PRIVACY_NOTICE_BODY="replace with adviser-approved notice text"
# RESEARCH_PRIVACY_NOTICE_SHA256=replace-with-lowercase-sha256
# RESEARCH_IDENTITY_HMAC_KEY=replace-with-a-generated-long-lived-suppression-hmac-key
# RESEARCH_RESEND_SEND_API_KEY=re_replace_with_scoped_send_key
# RESEARCH_RESEND_WEBHOOK_SECRET=whsec_replace_with_resend_signing-secret
# Public research requires the segment; the private POC may leave it blank
# while marketing/contact synchronization is disabled.
# RESEARCH_RESEND_SEGMENT_ID=replace-with-resend-segment-id
# For the private POC only, route all three values to the one owner mailbox:
# RESEARCH_EMAIL_TRANSACTIONAL_FROM=TreadJoy Research <ethan@tread-joy.com>
# RESEARCH_EMAIL_MARKETING_FROM=TreadJoy <ethan@tread-joy.com>
# RESEARCH_EMAIL_REPLY_TO=ethan@tread-joy.com
# Public research instead requires two distinct verified sender subdomains and
# the monitored hello@tread-joy.com reply mailbox.
# RESEARCH_RETENTION_POLICY_VERSION=replace-with-effective-policy-version
# The ordinary web process must not receive this management key. Configure it
# only for sync_research_resend and the permissioned broadcast job.
# RESEARCH_RESEND_MANAGEMENT_API_KEY=re_replace_with_management-key
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false


# -----------------------------------------------------------------------------
# Stripe sandbox (commerce mode only)
# -----------------------------------------------------------------------------

# Delete this entire section from a research deployment's environment.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me


# -----------------------------------------------------------------------------
# Optional homepage YouTube video or livestream
# -----------------------------------------------------------------------------

# Accepts an 11-character video ID or a supported HTTPS YouTube URL.
# Leave blank to render the development placeholder without an iframe.
HOMEPAGE_YOUTUBE_VIDEO_ID=
HOMEPAGE_YOUTUBE_TITLE=
